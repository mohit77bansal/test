# Copy to .env (kept outside git). docker compose reads it from the repo root.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=vendor.solfin.co.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://vendor.solfin.co.in
SITE_URL=https://vendor.solfin.co.in

# Postgres (superuser only used by init + backups; the app connects as the non-superuser APP_DB_USER so RLS applies)
POSTGRES_DB=vendor_portal
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
APP_DB_USER=vp_app
APP_DB_PASSWORD=change-me
DATABASE_URL=postgres://vp_app:change-me@postgres:5432/vendor_portal
REDIS_URL=redis://redis:6379/0

# Files: private S3 bucket in ap-south-1 with SSE-KMS
STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=solfin-vendor-portal
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_SSE_KMS=true
BACKUP_BUCKET=solfin-vendor-portal-backups

# Field encryption: KMS-encrypted data key (prod) or a Fernet key (local only)
KMS_KEY_ID=
KMS_ENCRYPTED_DATA_KEY=
FIELD_ENCRYPTION_KEY=

# Document parsing: textract (UAT/prod) | fake (tests, local)
PARSER_ENGINE=textract
LLM_ENGINE=none            # none | bedrock
BEDROCK_MODEL_ID=
VIRUS_SCAN_ENGINE=clamd
CLAMD_HOST=clamav

# Email: solfin_api | console
EMAIL_SENDER=solfin_api
SOLFIN_EMAIL_API_URL=
SOLFIN_EMAIL_API_KEY=
DEFAULT_FROM_EMAIL=Solfin Vendor Portal <no-reply@solfin.co.in>
AP_INBOX_EMAIL=ap@solfin.co.in

# Security / ops
OTP_ENABLED=true
SESSION_IDLE_SECONDS=1800
LOGIN_FAILURE_LIMIT=5
SENTRY_DSN=
LOG_LEVEL=INFO
